# Databricks Free Edition connection settings
# Copy this file to .env and fill in your values.
# Authentication uses a Databricks personal access token (PAT).

# Workspace hostname, e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com (no https://, no query string)
DATABRICKS_HOST=

# SQL Warehouse HTTP path (Databricks UI > SQL Warehouses > <warehouse> > Connection details)
DATABRICKS_HTTP_PATH=

# Unity Catalog / schema used by the notebooks and dbt project
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# Personal access token (Databricks UI > Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
